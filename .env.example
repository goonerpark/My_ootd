# =========================
# Docker Compose environment
# Copy to .env and edit values
# =========================

# Ports
FRONTEND_PORT=3000
BACKEND_PORT=8080
MARIADB_PORT=3307

# MariaDB
MARIADB_DATABASE=my_ootd
MARIADB_USER=ootd_user
MARIADB_PASSWORD=ootd_password
MARIADB_ROOT_PASSWORD=root_password

# Backend DB connection (container-to-container)
DB_URL=jdbc:mariadb://mariadb:3306/my_ootd
DB_USERNAME=ootd_user
DB_PASSWORD=ootd_password

# Security
JWT_SECRET=replace-with-a-long-random-secret-key-at-least-32-bytes
JWT_ACCESS_TOKEN_EXPIRATION_MS=3600000

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Weather
WEATHER_PROVIDER=openweather
WEATHER_CACHE_REFRESH_MINUTES=60
OPENWEATHER_API_KEY=

# Gemini
GEMINI_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# File upload
OOTD_IMAGE_LOCAL_DIR=/app/uploads/ootd-reviews
OOTD_IMAGE_URL_PREFIX=http://localhost:8080/uploads/ootd-reviews/
CLOSET_IMAGE_LOCAL_DIR=/app/uploads/closet-items
CLOSET_IMAGE_URL_PREFIX=http://localhost:8080/uploads/closet-items/
