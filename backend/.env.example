# =========================
# Backend environment
# =========================

# App
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# Database (MariaDB)
DB_URL=jdbc:mariadb://localhost:3307/my_ootd
DB_USERNAME=root
DB_PASSWORD=change-me

# JWT
JWT_SECRET=replace-with-a-long-random-secret-key-at-least-32-bytes
JWT_ACCESS_TOKEN_EXPIRATION_MS=3600000

# CORS (comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Weather
WEATHER_PROVIDER=openweather
WEATHER_CACHE_REFRESH_MINUTES=60
OPENWEATHER_API_KEY=

# Gemini
GEMINI_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# File upload
# Legacy unified aliases (optional for docs/ops)
FILE_UPLOAD_DIR=uploads
FILE_PUBLIC_BASE_URL=http://localhost:8080/uploads

# Actual properties used by current backend
OOTD_IMAGE_LOCAL_DIR=uploads/ootd-reviews
OOTD_IMAGE_URL_PREFIX=http://localhost:8080/uploads/ootd-reviews/
CLOSET_IMAGE_LOCAL_DIR=uploads/closet-items
CLOSET_IMAGE_URL_PREFIX=http://localhost:8080/uploads/closet-items/
